generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
    id        Int      @id @default(autoincrement())
    name      String?
    email     String   @unique
    active    Boolean  @default(true)
    role      Role     @default(EMPLOYEE)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum Role {
    ADMIN
    EMPLOYEE
}

model Season {
    id        Int        @id @default(autoincrement())
    year      Int
    type      SeasonType
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    @@unique([year, type])
}

enum SeasonType {
    SUMMER
    WINTER
}

model Field {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    area      Decimal
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}